# Copy to backend/.env and adjust. Every setting is optional.
# SHOPMIND_LLM_PROVIDER=lmstudio            # fake | ollama | lmstudio
# SHOPMIND_LMSTUDIO_MODEL=qwen2.5-7b-instruct

# WooCommerce: mock (demo data) or live (real store)
# SHOPMIND_WOO_MODE=live
# SHOPMIND_WOO_STORE_URL=http://localhost:8080
# SHOPMIND_WOO_CONSUMER_KEY=ck_...
# SHOPMIND_WOO_CONSUMER_SECRET=cs_...
# SHOPMIND_WOO_WEBHOOK_SECRET=shopmind-local-webhook-secret
# SHOPMIND_WOO_WRITEBACK=true
